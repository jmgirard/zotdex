---
import Base from "../layouts/Base.astro";
import { BASE } from "../data.ts";
---

<Base title="Page not found: Zotero plugin index" description="No page of the Zotero plugin index is at this address.">
  <div class="hero">
    <h1>Page not found</h1>
    <p class="intro" data-not-found>
      No page is at this address. A plugin's page goes away when the index no longer lists the plugin.{" "}
      <a href={BASE}>See all plugins</a> or read the <a href={`${BASE}about/`}>About page</a>.
    </p>
  </div>
</Base>
