---
import { majorSupport } from "../../../../../src/site/version.ts";
import Icon from "../../../components/Icon.astro";
import NoSourceMark from "../../../components/NoSourceMark.astro";
import PaidServiceMark from "../../../components/PaidServiceMark.astro";
import Base from "../../../layouts/Base.astro";
import {
  badgeSnippet,
  BASE,
  CATEGORIES,
  categories,
  compatMajors,
  day,
  declaredRange,
  displayName,
  githubRepo,
  languagesText,
  loadData,
  majorReport,
  majorStart,
  overrideUsed,
  PAID_SERVICE_TEXT,
  pluginHref,
  previewDescription,
  rangeText,
  reportHref,
  removeHref,
  textChangeHref,
  safeHref,
  shownDescription,
  starsText,
  startWords,
  SUPPORT_MARKS as MARKS,
  SUPPORT_WORDS,
  supportText,
  upstreamLines,
  type PluginRecord,
  INSTALL_HREF,
} from "../../../data.ts";

export function getStaticPaths() {
  return loadData().plugins.map((record) => ({ params: { id: record.id }, props: { record } }));
}

const { record } = Astro.props as { record: PluginRecord };
const { zoteroRelease, generatedAt } = loadData();
const { upstream, failure, overrides, paidService, kept } = record;
const paidHref = paidService && safeHref(paidService.source);
const repoUrl = upstream?.repoUrl ?? record.repoUrl;
const repoHref = safeHref(repoUrl);
const github = githubRepo(repoUrl);
const xpiHref = upstream?.xpiUrl === undefined ? undefined : safeHref(upstream.xpiUrl);
const description = shownDescription(record);
const slugs = categories(record);
const recordCategories = CATEGORIES.filter((category) => slugs.includes(category.slug));
const { min, max } = declaredRange(record);
---

<Base title={`${displayName(record)}: Zotdex`} description={previewDescription(record)} path={pluginHref(record.id)}>
  <a class="back" href={BASE} data-back><Icon name="back" />All plugins</a>
  <div class="page-head" data-page-head>
    <h1>
      {displayName(record)}
      {
        upstream?.archived === true && (
          <>
            {" "}
            <span class="badge" data-archived>Archived</span>
          </>
        )
      }
      {
        kept && (
          <>
            {" "}
            <span class="badge" data-kept>Older data</span>
          </>
        )
      }
      {
        upstream?.sourceInRepo === false && (
          <>
            {" "}
            <NoSourceMark />
          </>
        )
      }
      {
        paidService && (
          <>
            {" "}
            <PaidServiceMark />
          </>
        )
      }
    </h1>
    {
      kept && (
        <p class="fineprint kept-note" data-fact="kept">
          The build that wrote this page, on {day(generatedAt)}, could not read this plugin: <code>{kept.failure.name}</code>:{" "}
          {kept.failure.message}. These facts come from an earlier build, on {day(kept.readAt)}.{" "}
          <a href={`${BASE}about/#older-data`}>About older data</a>
        </p>
      )
    }
    {
      github && repoHref && (
        <p class="repo-line" data-repo-line>
          By <a href={`https://github.com/${github.owner}`} data-repo-owner>{github.owner}</a>{" "}
          <span aria-hidden="true">·</span>{" "}
          <a href={repoHref} data-repo-name>{github.repo}</a>
          {upstream?.stars !== undefined && (
            <>
              {" "}
              <span aria-hidden="true">·</span>{" "}
              <span data-repo-stars>
                <span aria-hidden="true" title={starsText(upstream.stars)}><Icon name="star" /> {upstream.stars.toLocaleString("en")}</span>{" "}
                <span class="visually-hidden">{starsText(upstream.stars)}</span>
              </span>
            </>
          )}
        </p>
      )
    }
    {description && <p class="description" data-description>{description}</p>}
    {
      recordCategories.length > 0 && (
        <p class="categories" data-categories>
          <a href={`${BASE}about/#categories`} data-categories-about>Index categories</a>:{" "}
          {recordCategories.map((category, i) => (
            <>
              {i > 0 && ", "}
              <a href={`${BASE}?category=${category.slug}`} aria-label={`${category.name}: plugins in this category`} data-category={category.slug}>{category.name}</a>
            </>
          ))}
        </p>
      )
    }
    <div class="actions" data-links>
      {
        upstream && xpiHref && (
          <a class="btn" href={xpiHref} data-link="download">
            <Icon name="download" />
            Download {upstream.version} (.xpi)
          </a>
        )
      }
      {
        repoHref ? (
          <a class="btn" href={repoHref} data-link="source">
            <Icon name="source" />
            {upstream?.sourceInRepo === false ? "Repository" : "Source"}
          </a>
        ) : (
          <span class="link-text" data-link="source">{repoUrl}</span>
        )
      }
      {
        upstream &&
          (repoHref ? (
            <a class="btn" href={`${repoHref}/releases`} data-link="releases">
              <Icon name="releases" />
              Releases
            </a>
          ) : (
            <span class="link-text" data-link="releases">{`${repoUrl}/releases`}</span>
          ))
      }
    </div>
  </div>
  {
    upstream && xpiHref && (
      <p class="install-note" data-fact="install-note">
        To install, save the .xpi file and drag it onto the Plugins window in Zotero (Tools → Plugins). In Firefox,
        right-click the download link and choose Save Link As. A plugin has full access to your Zotero and your computer,
        and the index does not review its code before listing it, so install only plugins from developers you
        trust.{" "}
        <a href={INSTALL_HREF}>More about installing</a>
      </p>
    )
  }
  <section class="card compat" data-section="compatibility">
    <h2>Zotero compatibility</h2>
    {
      upstream ? (
        <>
          <p class="sub" data-fact="read-version">For version {upstream.version}, the release the index read</p>
          <div class="table-wrap">
            <table class="compat-table">
              <thead>
                <tr>
                  <th scope="col">Zotero</th>
                  <th scope="col">Declared</th>
                  <th scope="col">Start test</th>
                  <th scope="col">User reports</th>
                </tr>
              </thead>
              <tbody>
                {compatMajors(record).map((major) => {
                  const support = majorSupport(record, major, zoteroRelease);
                  const start = majorStart(record, major);
                  const report = majorReport(record, major);
                  return (
                    <tr data-major={major}>
                      <th scope="row">{major}</th>
                      <td data-declared={support ?? "no-range"}>
                        {support ? (
                          <>
                            <span class="mark" data-support={support} title={supportText(record, support, major)} aria-hidden="true">
                              {MARKS[support]}
                            </span>{" "}
                            <span aria-hidden="true">{SUPPORT_WORDS[support]}</span>
                            <span class="visually-hidden">{supportText(record, support, major)}</span>
                          </>
                        ) : (
                          <span class="none">No range</span>
                        )}
                      </td>
                      <td data-start-cell>
                        {start ? (
                          <>
                            <span class="start" data-start={start.result} aria-hidden="true">
                              {start.result === "started" ? "●" : "✕"}
                            </span>{" "}
                            {startWords(start.result)} <span class="note">Zotero {start.zotero}</span>
                          </>
                        ) : (
                          <span class="none">Not tested</span>
                        )}
                      </td>
                      <td data-reports-cell>
                        {report ? (
                          <>
                            <span class="works">{report.works} works</span> <span class="broken">{report.broken} broken</span>
                          </>
                        ) : (
                          <span class="none">None yet</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="fineprint" data-about-line>
            {(min !== undefined || max !== undefined) && (
              <>
                Declared range: <span data-fact="declared-range">{rangeText(record)}</span>.{" "}
              </>
            )}
            <a href={`${BASE}about/`}>How the index reads plugins</a>
          </p>
          <div class="report-row" data-reports>
            <p id="report-prompt" data-fact="report-prompt">Tried version {upstream.version} on Zotero? Report what you found:</p>
            <div class="report-buttons">
              <a data-report="works" href={reportHref(record, "works")} class="button" aria-describedby="report-prompt">Works</a>
              <a data-report="broken" href={reportHref(record, "broken")} class="button" aria-describedby="report-prompt">Broken</a>
            </div>
          </div>
        </>
      ) : (
        failure && (
          <>
            <p data-fact="failure">
              The last build could not read this plugin: <code>{failure.name}</code>: {failure.message}
            </p>
            <p class="fineprint" data-about-line>
              <a href={`${BASE}about/`}>How the index reads plugins</a>
            </p>
          </>
        )
      )
    }
  </section>
  <section class="card" data-section="details">
    <h2>Details</h2>
    <dl class="facts">
      <div>
        <dt>Plugin id</dt>
        <dd data-fact="id"><code>{record.id}</code></dd>
      </div>
      {
        paidService && (
          <div>
            <dt>{PAID_SERVICE_TEXT}</dt>
            <dd data-fact="paid-service">
              {paidService.note}{" "}
              {paidHref ? <a href={paidHref} data-paid-source>Source of this fact</a> : paidService.source}, read {paidService.read}
            </dd>
          </div>
        )
      }
      {
        upstream && (
          <>
            {upstream.description !== undefined && upstream.description.trim() !== "" && (
              <div>
                <dt>Manifest description</dt>
                <dd data-fact="manifest-description">{upstream.description}</dd>
              </div>
            )}
            {upstream.repoDescription !== undefined && (
              <div>
                <dt>GitHub description</dt>
                <dd data-fact="github-description">{upstream.repoDescription}</dd>
              </div>
            )}
            {typeof upstream.archived === "boolean" && (
              <div>
                <dt>Archived on GitHub</dt>
                <dd data-fact="archived">{upstream.archived ? "Yes" : "No"}</dd>
              </div>
            )}
            {typeof upstream.sourceInRepo === "boolean" && (
              <div>
                <dt>Source code at the repository's top level</dt>
                <dd data-fact="source-in-repo">{upstream.sourceInRepo ? "Yes" : "No"}</dd>
              </div>
            )}
            <div>
              <dt>Repository created</dt>
              <dd data-fact="repo-created">{day(upstream.repoCreatedAt)}</dd>
            </div>
            <div>
              <dt>Release read by the index</dt>
              <dd data-fact="latest-release">
                {upstream.version}, published {day(upstream.latestReleaseDate)}
                {upstream.prerelease === true && " (prerelease)"}
              </dd>
            </div>
            <div>
              <dt>Releases with an .xpi</dt>
              <dd data-fact="release-count">{upstream.releaseCount}</dd>
            </div>
            <div>
              <dt>Open issues and pull requests</dt>
              <dd data-fact="open-issues">{upstream.openIssues}</dd>
            </div>
            <div>
              <dt>Host of update.json</dt>
              <dd data-fact="update-host">{upstream.updateHost}</dd>
            </div>
            <div>
              <dt>Menus and settings in</dt>
              <dd data-fact="languages">{languagesText(record)}</dd>
            </div>
          </>
        )
      }
    </dl>
    {
      overrides.length > 0 && (
        <div class="overrides" data-overrides>
          <h3>Overrides</h3>
          <p>The index corrects, fills in, or replaces these upstream facts.</p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Field</th>
                  <th>Upstream value</th>
                  <th>Override value</th>
                  <th>For version</th>
                  <th>Used</th>
                  <th>Reason</th>
                </tr>
              </thead>
              <tbody>
                {overrides.map((override) => (
                  <tr data-override={override.field}>
                    <td><code>{override.field}</code></td>
                    <td>{upstreamLines(record, override.field).map((line, index) => <>{index > 0 && <br />}{line}</>)}</td>
                    <td>{override.value}</td>
                    <td>{override.version ?? "every version"}</td>
                    <td>{overrideUsed(record, override) ? "yes" : "no"}</td>
                    <td>{override.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
    <p class="fineprint">
      Is this your plugin? <a href={textChangeHref(record)} data-text-change>Ask to change its name or description</a>.
    </p>
    <p class="fineprint">
      <a href={removeHref(record)} data-remove-plugin>Ask to remove this plugin or report harm</a>.
    </p>
  </section>
  <section class="card" data-section="badge">
    <h2>Badge for your README</h2>
    <p class="fineprint">
      If this is your plugin, you can add this Markdown to its README. The badge shows the Zotero versions it
      started in here, or why it names none, and it links to this page.
    </p>
    <code class="badge-snippet" data-badge-snippet>{badgeSnippet(record.id)}</code>
  </section>
</Base>
