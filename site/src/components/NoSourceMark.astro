---
// The mark of a plugin whose repo shows no source code at its top level (D-052). The icon is
// hidden from screen readers, so the hidden span carries the words, as a declared mark does.
import Icon from "./Icon.astro";

const TEXT = "No source code at the top level of the repository";
---

<span class="no-source" data-no-source title={TEXT}><Icon name="lock" /><span class="visually-hidden">{TEXT}</span></span>
