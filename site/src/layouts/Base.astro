---
import { fullShapes, PICTURES } from "../../../src/site/logo.ts";
import { applySavedTheme, wireThemeButton } from "../../../src/site/theme.ts";
import { BASE, ORIGIN } from "../base.ts";
import Icon from "../components/Icon.astro";
import { ADD_PLUGIN_HREF, DISCLAIMER, FEEDBACK_HREF, loadData, longDay, REPO_HREF } from "../data.ts";

interface Props {
  title: string;
  // The text of a shared link's preview and of search results.
  description: string;
  // The page's address from the host on, encoded, such as pluginHref gives. The 404 page has
  // no address of its own, so it leaves this out and asks search engines not to index it.
  path?: string;
}
const { title, description, path } = Astro.props;
const { generatedAt } = loadData();
const address = path === undefined ? undefined : `${ORIGIN}${path}`;
const faviconSize = PICTURES["favicon.png"].size;

const themeHead = `(${applySavedTheme})();`;
const themeButton = `(${wireThemeButton})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {address ? <link rel="canonical" href={address} /> : <meta name="robots" content="noindex" />}
    {/* The PNG is for a browser that shows no SVG icon. Its sizes value keeps Chrome from choosing it over the SVG. */}
    <link rel="icon" type="image/png" sizes={`${faviconSize}x${faviconSize}`} href={`${BASE}favicon.png`} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
    <link rel="sitemap" type="application/xml" href={`${BASE}sitemap.xml`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zotdex" />
    {address && <meta property="og:url" content={address} />}
    <meta property="og:image" content={`${ORIGIN}${BASE}preview.png`} />
    <meta property="og:image:width" content={String(PICTURES["preview.png"].size)} />
    <meta property="og:image:height" content={String(PICTURES["preview.png"].size)} />
    <meta property="og:image:alt" content="The Zotdex logo" />
    <meta name="twitter:card" content="summary" />
    <script is:inline set:html={themeHead} />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f7f7f5;
        --surface: #ffffff;
        --hover: #f2f2ee;
        --text: #1c1c1a;
        --muted: #6b6b66;
        --faint: #8a8a84;
        --line: #e4e4df;
        --line-strong: #d3d3cc;
        --accent: #1d5fb8;
        --link: #1d5fb8;
        --ok: #1f7a3d;
        --ok-bg: #e3f3e7;
        --part: #8a5a00;
        --part-bg: #fbefd5;
        --bad: #b3261e;
        --bad-bg: #fbe4e1;
        --none: #8f8f88;
        --star: #b07d00;
        /* The logo's lens disc and Z. Its body is --accent. src/site/logo.ts holds the same fills. */
        --logo-disc: #a9cbff;
        --logo-z: #0e2f5c;
        /* --space-N is N eighths of a rem. */
        --space-1: 0.125rem;
        --space-2: 0.25rem;
        --space-3: 0.375rem;
        --space-4: 0.5rem;
        --space-5: 0.625rem;
        --space-6: 0.75rem;
        --space-8: 1rem;
        --space-9: 1.125rem;
        --space-10: 1.25rem;
        --space-12: 1.5rem;
        --space-14: 1.75rem;
        --space-16: 2rem;
        --space-24: 3rem;
        --text-3xs: 0.625rem;
        --text-2xs: 0.6875rem;
        --text-xs: 0.75rem;
        --text-s: 0.8125rem;
        --text-m: 0.875rem;
        --text-base: 0.9375rem;
        --text-xl: 1.375rem;
        --radius-xs: 0.125rem;
        --radius-s: 0.25rem;
        --radius-m: 0.375rem;
        --radius: 0.5rem;
        --page-width: 65rem;
        --card-border: var(--line);
        --card-padding: var(--space-6) var(--space-8);
      }
      /* The next two blocks hold the same dark colors: a page with no saved scheme follows the
         system, and data-theme, set by the head script or the top bar's button, holds a saved one. */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #161615;
          --surface: #1e1e1c;
          --hover: #262624;
          --text: #ecece8;
          --muted: #a3a39c;
          --faint: #6e6e68;
          --line: #2e2e2b;
          --line-strong: #3d3d39;
          --accent: #7fb0ff;
          --link: #7fb0ff;
          --ok: #6fd08c;
          --ok-bg: #173322;
          --part: #f0c060;
          --part-bg: #3a2e12;
          --bad: #ff8a80;
          --bad-bg: #3d1a17;
          --none: #74746d;
          --star: #e3b341;
          --logo-disc: #1d5fb8;
          --logo-z: #ffffff;
        }
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #161615;
        --surface: #1e1e1c;
        --hover: #262624;
        --text: #ecece8;
        --muted: #a3a39c;
        --faint: #6e6e68;
        --line: #2e2e2b;
        --line-strong: #3d3d39;
        --accent: #7fb0ff;
        --link: #7fb0ff;
        --ok: #6fd08c;
        --ok-bg: #173322;
        --part: #f0c060;
        --part-bg: #3a2e12;
        --bad: #ff8a80;
        --bad-bg: #3d1a17;
        --none: #74746d;
        --star: #e3b341;
        --logo-disc: #1d5fb8;
        --logo-z: #ffffff;
      }
      :root[data-theme="light"] {
        color-scheme: light;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: var(--text-base);
        line-height: 1.5;
        font-variant-numeric: tabular-nums;
        color: var(--text);
        background: var(--bg);
        overflow-wrap: anywhere;
      }
      a {
        color: var(--link);
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      .icon {
        width: 1rem;
        height: 1rem;
        flex: none;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* The top bar, the main content, and the footer share one width. */
      .topbar-inner,
      main,
      .foot-inner {
        max-width: var(--page-width);
        margin: 0 auto;
        padding: 0 var(--space-8);
      }
      .topbar {
        background: var(--surface);
        border-bottom: 1px solid var(--line);
      }
      .topbar-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-12);
        min-height: 3.25rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        font-size: var(--text-xl);
        font-weight: 650;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      /* The logo is the full mark (src/site/logo.ts, D-074), its three shapes filled from the
         tokens. The lights, the lid line, and the ring around the disc are cut out of the body. */
      .brand .logo {
        width: 2rem;
        height: 2rem;
        flex: none;
      }
      .brand .logo-body {
        fill: var(--accent);
      }
      .brand .logo-disc {
        fill: var(--logo-disc);
      }
      .brand .logo-z {
        fill: var(--logo-z);
      }
      /* Forced colors keep the Z apart from the disc it sits on. */
      @media (forced-colors: active) {
        .brand .logo-body,
        .brand .logo-disc {
          fill: CanvasText;
        }
        .brand .logo-z {
          fill: Canvas;
        }
      }
      .topbar nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-10);
        margin-left: auto;
        font-size: var(--text-m);
      }
      .topbar nav a {
        color: var(--muted);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand:hover,
      .topbar nav a:hover {
        color: var(--text);
        text-decoration: underline;
      }
      /* The GitHub mark sits in a box the size of the theme button beside it. */
      .topbar nav .repo-link {
        display: inline-grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: var(--radius-m);
      }
      .topbar nav .repo-link:hover {
        background: var(--line);
      }
      .topbar nav .repo-link:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      [data-theme-toggle] {
        display: inline-grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        border: 0;
        border-radius: var(--radius-m);
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
      }
      [data-theme-toggle]:hover {
        background: var(--line);
        color: var(--text);
      }
      [data-theme-toggle]:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      /* The script writes data-gives, the scheme that a press gives, so one icon shows. */
      [data-theme-icon] {
        display: contents;
      }
      [data-gives="dark"] [data-theme-icon="sun"],
      [data-gives="light"] [data-theme-icon="moon"] {
        display: none;
      }
      .foot {
        margin: var(--space-24) 0 var(--space-16);
        font-size: var(--text-s);
        color: var(--muted);
      }
      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3) var(--space-12);
      }
      .foot-rule {
        border-top: 1px solid var(--line);
        padding-top: var(--space-8);
      }
      .foot p {
        margin: 0;
      }

      /* The home page: heading, the card of controls, table, and pager, and the legend. */
      .hero {
        padding: var(--space-14) 0 var(--space-4);
      }
      .hero h1 {
        margin: 0 0 var(--space-2);
        font-size: var(--text-xl);
        line-height: 1.25;
        letter-spacing: -0.015em;
      }
      .intro {
        margin: 0;
        color: var(--muted);
      }
      /* One card holds the two groups of controls, the table, and the pager. */
      .table-panel {
        margin-top: var(--space-4);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
      }
      .table-card {
        overflow-x: auto;
      }
      /* With no pager below it, the last row's hover fill stays inside the card's corners. */
      .table-card:has(+ .pager[hidden]) {
        border-radius: 0 0 var(--radius) var(--radius);
      }
      .controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto auto;
        align-items: end;
        gap: var(--space-6) var(--space-8);
        /* Above 560 px, the same side padding as the table's cells, so the left edges line up. */
        padding: var(--space-6);
        border-bottom: 1px solid var(--line);
      }
      .results {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4) var(--space-8);
        padding: var(--space-3) var(--space-6);
        border-bottom: 1px solid var(--line);
      }
      .controls p,
      .results p {
        margin: 0;
      }
      .search {
        position: relative;
      }
      .search .icon {
        position: absolute;
        left: 0.625rem;
        top: 0.5rem;
        color: var(--faint);
      }
      /* Every control has one height, text size, corner, and edge. The edges take --faint, which the
         color test holds at 3:1 on --surface. */
      .search input,
      [data-language-filter],
      [data-category-filter],
      [data-sort],
      [data-version-filter],
      .pager button {
        height: 2rem;
        border: 1px solid var(--faint);
        border-radius: var(--radius-m);
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: var(--text-m);
      }
      .search input {
        width: 100%;
        padding: 0 var(--space-5) 0 var(--space-16);
      }
      /* The page draws each menu's arrow in place of the browser's: two triangles in currentColor
         make one down arrow, inset from the right edge by the left padding. */
      [data-language-filter],
      [data-category-filter],
      [data-sort] {
        max-width: 100%;
        padding: 0 var(--space-14) 0 var(--space-4);
        appearance: none;
        background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
        background-position:
          right calc(var(--space-4) + var(--space-3)) top 50%,
          right var(--space-4) top 50%;
        background-size: var(--space-3) var(--space-3);
        background-repeat: no-repeat;
      }
      /* Forced colors drop gradients, so each menu keeps the browser's own arrow there. */
      @media (forced-colors: active) {
        [data-language-filter],
        [data-category-filter],
        [data-sort] {
          padding-right: var(--space-4);
          appearance: auto;
        }
      }
      /* Each filter's label sits above its control. */
      .language-filter,
      .category-filter,
      .version-filter {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        min-width: 0;
      }
      .language-filter select,
      .category-filter select {
        width: 100%;
      }
      /* Every visible label reads like the table's column headers. */
      .language-filter label,
      .category-filter label,
      .sort-menu label,
      #version-filter-label {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--muted);
        overflow-wrap: normal;
      }
      /* Two classes outrank .results p, which clears the margins of the row's paragraphs. */
      .results .sort-menu {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        margin-left: auto;
      }
      /* A script removes hidden from these, so a page without JavaScript shows no control. */
      [data-theme-toggle][hidden],
      .controls[hidden],
      .results[hidden],
      .filter-status[hidden],
      .pager[hidden] {
        display: none;
      }
      /* max-content, so at larger browser text the overflow rule that holds the corners cuts off no button. */
      [data-version-filter] {
        display: flex;
        min-width: max-content;
        overflow: hidden;
      }
      [data-version-filter] button {
        flex: 1 1 auto;
        padding: 0 var(--space-5);
        border: 0;
        border-left: 1px solid var(--faint);
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        cursor: pointer;
      }
      [data-version-filter] button:first-child {
        border-left: 0;
      }
      [data-version-filter] button[aria-pressed="true"] {
        background: var(--hover);
        color: var(--text);
        font-weight: 600;
        box-shadow: inset 0 -2px 0 var(--accent);
      }
      /* background-color alone, since each menu draws its arrow in background-image. */
      .search input:hover,
      [data-language-filter]:hover,
      [data-category-filter]:hover,
      [data-sort]:hover,
      [data-version-filter] button:not([aria-pressed="true"]):hover,
      .pager button:not([aria-disabled="true"]):hover {
        background-color: var(--hover);
        color: var(--text);
      }
      .search input:focus-visible,
      [data-language-filter]:focus-visible,
      [data-category-filter]:focus-visible,
      [data-sort]:focus-visible,
      [data-version-filter] button:focus-visible,
      .pager button:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      [data-version-filter]:has(button:focus-visible) {
        overflow: visible;
      }
      /* Forced colors replace the backgrounds, so a thicker border marks the pressed button. */
      @media (forced-colors: active) {
        [data-version-filter] button[aria-pressed="true"] {
          border: 3px solid ButtonText;
        }
      }
      .filter-status {
        font-size: var(--text-s);
        font-weight: 600;
      }
      .plugins th,
      .plugins td {
        padding: var(--space-5) var(--space-6);
        border-bottom: 0;
        vertical-align: middle;
      }
      .plugins thead th {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
      }
      .plugins .group th {
        padding-bottom: 0;
        border-bottom: 0;
        font-weight: 500;
        text-align: center;
      }
      .plugins .group th span {
        display: block;
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--line);
      }
      /* A row gets a top border only after a shown row, so the first shown row has none. The home
         page's pre-paint style hides rows without hidden, so it drops its first row's border. */
      .plugins tbody tr:not([hidden]) ~ tr {
        border-top: 1px solid var(--line);
      }
      .plugins tbody tr:hover {
        background: var(--hover);
      }
      .plugins .name {
        width: 100%;
        font-weight: 400;
      }
      .plugins .name a {
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
      }
      .plugins .name a:hover {
        color: var(--link);
        text-decoration: underline;
      }
      /* contain adds nothing to the cell's minimum width, so a long owner is cut to the cell's
         width and does not widen the table. Only the owner is cut, so a star count stays whole. */
      .owner {
        display: flex;
        gap: var(--space-2);
        contain: inline-size;
        font-size: var(--text-xs);
        color: var(--faint);
        white-space: nowrap;
      }
      .owner-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .row-stars {
        flex: none;
        color: var(--muted);
      }
      .row-stars .icon {
        width: 0.75rem;
        height: 0.75rem;
        fill: currentColor;
        stroke: none;
        vertical-align: -0.125em;
      }
      .desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-width: 60ch;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .badge {
        display: inline-block;
        margin-left: var(--space-3);
        padding: 0 var(--space-3);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-s);
        font-size: var(--text-2xs);
        font-weight: 600;
        color: var(--muted);
        vertical-align: 1px;
      }
      .no-source,
      .paid-service {
        margin-left: var(--space-3);
        color: var(--muted);
      }
      .plugins .v {
        width: 2.5rem;
        padding-left: var(--space-1);
        padding-right: var(--space-1);
        text-align: center;
      }
      .plugins .not-read {
        width: auto;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .mark {
        display: inline-grid;
        place-items: center;
        width: 1.625rem;
        height: 1.375rem;
        border-radius: var(--radius-s);
        font-size: var(--text-xs);
        font-weight: 700;
        line-height: 1;
      }
      .mark[data-support="all"] {
        background: var(--ok-bg);
        color: var(--ok);
      }
      .mark[data-support="some"] {
        background: var(--part-bg);
        color: var(--part);
      }
      .mark[data-support="none"] {
        color: var(--none);
      }
      .start {
        display: block;
        height: 0.75rem;
        margin-top: var(--space-1);
        font-size: var(--text-3xs);
        line-height: 0.75rem;
        color: var(--bad);
        font-weight: 700;
      }
      .start[data-start="started"] {
        color: var(--ok);
        font-weight: 400;
      }
      .plugins .lang,
      .plugins .date {
        white-space: nowrap;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .plugins .lang abbr {
        display: inline-block;
        padding: 0 var(--space-2);
        border-radius: var(--radius-xs);
        background: var(--hover);
        color: var(--muted);
        font-size: var(--text-2xs);
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
      }
      .plugins .lang abbr.more {
        background: none;
        text-transform: none;
      }
      .plugins .links {
        padding-left: var(--space-2);
        white-space: nowrap;
        text-align: right;
      }
      .plugins .links a {
        display: inline-grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: var(--radius-m);
        color: var(--muted);
      }
      .plugins .links a:hover {
        background: var(--line);
        color: var(--text);
      }
      .plugins .links a:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: -2px;
      }
      /* The pager at the foot of the card, shown by the script when the filters pass more than one page. */
      .pager {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4) var(--space-6);
        padding: var(--space-3) var(--space-6);
        border-top: 1px solid var(--line);
        font-size: var(--text-s);
        color: var(--muted);
      }
      .pager button {
        padding: 0 var(--space-6);
        cursor: pointer;
      }
      .pager button[aria-disabled="true"] {
        color: var(--faint);
        cursor: default;
      }
      /* Forced colors replace --faint, so GrayText marks a button at an end. */
      @media (forced-colors: active) {
        .pager button[aria-disabled="true"] {
          color: GrayText;
          border-color: GrayText;
        }
      }
      .legend {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-9);
        margin: var(--space-6) var(--space-1) 0;
        padding: 0;
        list-style: none;
        font-size: var(--text-xs);
        color: var(--muted);
      }
      .legend li {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
      }
      .legend .start {
        display: inline;
        margin: 0;
      }
      /* These steps are in rem, so they follow the browser's text size as the controls do. At 62.5rem
         or less the menus' natural widths leave the search box too little, so it takes its own row. */
      @media (max-width: 62.5rem) {
        .controls {
          grid-template-columns: auto 1fr auto;
        }
        .search {
          grid-column: 1 / -1;
        }
      }
      /* About here, the two menus and the version buttons stop fitting on one row at natural widths. */
      @media (max-width: 47.5rem) {
        .controls {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }
        .version-filter {
          grid-column: 1 / -1;
        }
      }
      /* Below this, side by side, the menus near the width that cuts "All categories". */
      @media (max-width: 21.25rem) {
        .controls {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (max-width: 760px) {
        .plugins .lang,
        .plugins .date {
          display: none;
        }
      }
      @media (max-width: 560px) {
        .plugins .desc,
        .plugins .links a[data-link="source"] {
          display: none;
        }
        .plugins th,
        .plugins td {
          padding: var(--space-4) var(--space-3);
        }
        .plugins .v {
          width: 1.875rem;
          padding-left: 0;
          padding-right: 0;
        }
        .mark {
          width: 1.375rem;
        }
      }

      /* The plugin pages: head, cards, the compatibility table, report buttons, and the Details section. */
      .card {
        background: var(--surface);
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        padding: var(--card-padding);
      }
      main > .card {
        margin: 0 0 var(--space-8);
      }
      .card > :first-child {
        margin-top: 0;
      }
      .card > :last-child {
        margin-bottom: 0;
      }
      .back {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        margin: var(--space-10) 0 0;
        font-size: var(--text-s);
        color: var(--muted);
        text-decoration: none;
      }
      .back:hover {
        color: var(--text);
        text-decoration: underline;
      }
      .page-head {
        padding: var(--space-6) 0 var(--space-10);
      }
      .page-head h1 {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-5);
        margin: 0;
        font-size: var(--text-xl);
        line-height: 1.25;
        letter-spacing: -0.015em;
      }
      .page-head h1 .badge {
        margin-left: 0;
        font-size: var(--text-xs);
        letter-spacing: 0;
      }
      .page-head h1 .no-source,
      .page-head h1 .paid-service {
        margin-left: 0;
      }
      .page-head .repo-line {
        margin: var(--space-3) 0 0;
        color: var(--muted);
      }
      .page-head .repo-line a {
        color: var(--text);
        font-weight: 600;
      }
      /* The star stays on the line of its count. */
      [data-repo-stars] {
        white-space: nowrap;
      }
      /* The star is filled, so it drops the line icons' stroke. */
      [data-repo-stars] .icon {
        fill: var(--star);
        stroke: none;
        vertical-align: -0.125em;
      }
      @media (forced-colors: active) {
        [data-repo-stars] .icon {
          fill: CanvasText;
        }
      }
      .page-head .description {
        max-width: 68ch;
        margin: var(--space-3) 0 0;
        color: var(--muted);
      }
      .page-head .categories {
        margin: var(--space-3) 0 0;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .kept-note {
        max-width: 68ch;
        margin: 0 0 var(--space-4);
      }
      .install-note {
        max-width: 68ch;
        margin: 0 0 var(--space-10);
        font-size: var(--text-s);
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        margin: var(--space-8) 0 0;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        min-height: 2rem;
        padding: var(--space-1) var(--space-6);
        /* --faint, as on the home controls, so the edge holds 3:1 on --bg and --surface. */
        border: 1px solid var(--faint);
        border-radius: var(--radius-m);
        background: var(--surface);
        color: var(--text);
        font-size: var(--text-m);
        font-weight: 500;
        text-decoration: none;
      }
      .btn:hover {
        background: var(--hover);
      }
      .btn:focus-visible,
      .back:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      .link-text {
        font-size: var(--text-m);
        color: var(--muted);
      }
      .card h2 {
        margin: 0 0 var(--space-2);
        font-size: var(--text-base);
        font-weight: 650;
      }
      .card h3 {
        margin: var(--space-10) 0 var(--space-2);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .card p {
        margin: var(--space-4) 0;
      }
      .report-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin: var(--space-4) 0 0;
      }
      .button {
        display: inline-block;
        min-width: 5rem;
        padding: var(--space-3) var(--space-8);
        /* The fills are close to the card color, so the text color draws each button's edge. */
        border: 1px solid currentColor;
        border-radius: var(--radius-m);
        font-weight: 600;
        text-align: center;
        text-decoration: none;
      }
      .button:hover {
        text-decoration: underline;
      }
      .button:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      .button[data-report="works"] {
        background: var(--ok-bg);
        color: var(--ok);
      }
      .button[data-report="broken"] {
        background: var(--bad-bg);
        color: var(--bad);
      }
      /* Forced colors replace the text and border colors, so this rule draws each button's edge in ButtonText. */
      @media (forced-colors: active) {
        .button,
        .btn {
          border-color: ButtonText;
        }
      }
      .compat .sub,
      .fineprint {
        font-size: var(--text-s);
        color: var(--muted);
      }
      /* The README badge's Markdown: one block that wraps anywhere, so a long address fits. */
      .badge-snippet {
        display: block;
        padding: var(--space-4) var(--space-6);
        border-radius: var(--radius-m);
        background: var(--hover);
        font-size: var(--text-s);
        overflow-wrap: anywhere;
      }
      /* Words in the table break only at spaces, so a narrow header wraps between words. */
      .compat-table {
        overflow-wrap: normal;
      }
      .compat-table th,
      .compat-table td {
        padding: var(--space-5) var(--space-6);
        border-bottom: 0;
        vertical-align: middle;
      }
      .compat-table td[data-declared] {
        white-space: nowrap;
      }
      @media (max-width: 560px) {
        .compat-table th,
        .compat-table td {
          padding: var(--space-4) var(--space-3);
        }
      }
      .compat-table thead th {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
      }
      .compat-table tbody tr + tr {
        border-top: 1px solid var(--line);
      }
      .compat-table th[scope="row"] {
        width: 1%;
        font-weight: 600;
        white-space: nowrap;
      }
      .compat-table .start,
      [data-about] .start {
        display: inline;
        height: auto;
        margin: 0;
        font-size: var(--text-xs);
        line-height: inherit;
      }
      .compat-table .note,
      .compat-table .none {
        font-size: var(--text-s);
        color: var(--muted);
      }
      .compat-table .works,
      .compat-table .broken {
        font-size: var(--text-s);
        font-weight: 600;
        white-space: nowrap;
      }
      .compat-table .works {
        color: var(--ok);
      }
      .compat-table .broken {
        color: var(--bad);
      }
      .report-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4) var(--space-8);
        margin: var(--space-6) 0 0;
        padding: var(--space-6) 0 0;
        border-top: 1px solid var(--line);
      }
      .card .report-row p {
        margin: 0;
        font-weight: 500;
      }
      .report-row .report-buttons {
        margin: 0;
      }
      .about-list {
        display: grid;
        gap: var(--space-3);
        margin: var(--space-4) 0;
        padding: 0;
        list-style: none;
      }
      .facts {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
        gap: var(--space-8) var(--space-12);
        margin: var(--space-6) 0 0;
      }
      .facts dt {
        font-size: var(--text-xs);
        color: var(--muted);
      }
      .facts dd {
        margin: var(--space-1) 0 0;
        font-size: var(--text-m);
      }
      .overrides p,
      .overrides table {
        font-size: var(--text-s);
      }
      /* As in the compat table, so a narrow column wraps between words. */
      .overrides table {
        overflow-wrap: normal;
      }
      .table-wrap {
        overflow-x: auto;
      }
      table {
        border-collapse: collapse;
        width: 100%;
      }
      th,
      td {
        text-align: left;
        padding: var(--space-2) var(--space-4);
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={BASE}><svg class="logo" viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={fullShapes()} />Zotdex</a>
        <nav aria-label="Site">
          <a href={`${BASE}about/`}>About</a>
          <a href={ADD_PLUGIN_HREF} data-add-plugin>Add a plugin</a>
          <a href={FEEDBACK_HREF} data-feedback>Feedback</a>
          <a href={`${BASE}v1/plugins.json`}>Data</a>
          <a href={REPO_HREF} class="repo-link" data-repo title="Zotdex on GitHub" aria-label="Zotdex on GitHub"><Icon name="source" /></a>
          <button type="button" data-theme-toggle hidden>
            <span data-theme-icon="moon"><Icon name="moon" /></span>
            <span data-theme-icon="sun"><Icon name="sun" /></span>
          </button>
          <script is:inline set:html={themeButton} />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-inner foot-rule">
        <p data-fact="disclaimer">{DISCLAIMER}</p>
        <p>Updated {longDay(generatedAt)}.</p>
        <p><a href={`${BASE}v1/plugins.json`}>Get all the data as JSON</a></p>
        <p><a href={REPO_HREF} data-repo-footer>Zotdex on GitHub</a></p>
      </div>
    </footer>
  </body>
</html>
