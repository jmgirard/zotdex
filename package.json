{
  "name": "zotdex",
  "version": "0.0.0",
  "private": true,
  "description": "A community index of Zotero 7+ plugins",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "add-plugin": "node src/add-plugin/cli.ts",
    "add-scan-results": "node src/malware-scan/add-results-cli.ts",
    "add-start-results": "node src/start-test/add-results-cli.ts",
    "build": "node src/build/cli.ts",
    "carry-scan-results": "node src/malware-scan/carry-cli.ts",
    "carry-start-results": "node src/start-test/carry-cli.ts",
    "check": "node src/check/cli.ts",
    "close-issue": "node src/discover/close-issue-cli.ts",
    "data-digest": "node src/build/digest-cli.ts",
    "description-gaps": "node src/site/description-gaps-cli.ts",
    "discover": "node src/discover/cli.ts",
    "discover-issue": "node src/discover/issue-cli.ts",
    "malware-scan": "node src/malware-scan/cli.ts",
    "merge-discover": "node src/discover/merge-cli.ts",
    "refresh-holds": "node src/discover/refresh-holds-cli.ts",
    "propose": "node src/discover/propose-cli.ts",
    "report-issue": "node src/reports/issue-cli.ts",
    "screenshot-request": "node src/screenshot-request/cli.ts",
    "site": "node src/site/cli.ts",
    "text-request": "node src/text-request/cli.ts",
    "start-test": "node src/start-test/cli.ts",
    "start-tests": "node src/start-test/start-tests-cli.ts",
    "unanswered-issues": "node src/issues/cli.ts",
    "test": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "astro": "7.4.2",
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  }
}
