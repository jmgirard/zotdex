{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Listed sites: sites that courts ordered blocked or shut down for copyright infringement",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["site", "names", "rulings"],
    "properties": {
      "site": { "type": "string", "minLength": 1, "maxLength": 100 },
      "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
      "rulings": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country", "court", "date", "case", "kind", "url"],
          "properties": {
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "court": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
            "case": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["contested judgment", "default judgment", "blocking order"] },
            "url": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
